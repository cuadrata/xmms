#: General/song_change/song_change.c:313
#, c-format
msgid ""
"You can use the following format strings which will be substituted before "
"calling the command (not all are useful for the end-of-playlist command).\n"
"\n"
"%%F: Frequency (in hertz)\n"
"%%c: Number of channels\n"
"%%f: filename (full path)\n"
"%%l: length (in milliseconds)\n"
"%%n or %%s: Song name\n"
"%%r: Rate (in bits per second)\n"
"%%t: Playlist position (%%02d)\n"
"%%p: Currently playing (1 or 0)"
msgstr ""
"De volgende opmaaktekens worden vervangen voordat de opdracht wordt "
"aangeroepen (niet alle zijn zinvol voor de opdracht aan het einde van de "
"afspeellijst).\n"
"\n"
"%%F: frequentie (in hertz)\n"
"%%c: aantal kanalen\n"
"%%f: bestandsnaam (volledig pad)\n"
"%%l: lengte (in milliseconden)\n"
"%%n of %%s: naam van het nummer\n"
"%%r: bitsnelheid (in bits per seconde)\n"
"%%t: positie in de afspeellijst (%%02d)\n"
"%%p: speelt nu (1 of 0)"

