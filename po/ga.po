#: General/song_change/song_change.c:313
#, c-format
msgid ""
"You can use the following format strings which will be substituted before "
"calling the command (not all are useful for the end-of-playlist command).\n"
"\n"
"%%F: Frequency (in hertz)\n"
"%%c: Number of channels\n"
"%%f: filename (full path)\n"
"%%l: length (in milliseconds)\n"
"%%n or %%s: Song name\n"
"%%r: Rate (in bits per second)\n"
"%%t: Playlist position (%%02d)\n"
"%%p: Currently playing (1 or 0)"
msgstr ""
"Is féidir na teaghráin fhormáide seo a leanas a úsáid; cuirfear ina n-ionad "
"sula nglaofar an t-ordú (ní bhíonn gach ceann úsáideach don ordú ag deireadh "
"an seinnliosta).\n"
"\n"
"%%F: Minicíocht (i heirts)\n"
"%%c: Líon na gcainéal\n"
"%%f: ainm comhaid (conair iomlán)\n"
"%%l: fad (i milleasoicindí)\n"
"%%n nó %%s: Ainm an amhráin\n"
"%%r: Ráta (i ngiotáin sa soicind)\n"
"%%t: Ionad sa seinnliosta (%%02d)\n"
"%%p: Á sheinm anois (1 nó 0)"

