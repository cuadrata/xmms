msgid "Convert %20 to space"
msgstr "გადააკეთე %20 გამოტოვებად"

#: xmms/prefswin.c:981
msgid "Always show clutterbar"
msgstr "ყოველთვის აჩვენე clutterbar"

#: xmms/prefswin.c:982
msgid ""
"The \"clutterbar\" is the row of buttons at the left side of the main window"
msgstr ""
"\"clutterbar\" არის მთავარი სარკმელის მარცხნივ განლაგებული ღილაკტა რიგი"

