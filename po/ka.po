msgstr "დაკვრა"

#: xmms/prefswin.c:969
msgid "Read song title and length only when starting to play"
msgstr "წაიკითხე სიმღერის სათაური და სიგრძე მხოლოდ როცა დაკვრას დაიწყებ"

#: xmms/prefswin.c:971
msgid "demand"
msgstr "მოთხოვნა"

#: xmms/prefswin.c:972
msgid "Read song title and length when the song is visible in the playlist"
msgstr ""
"სიმღერის სათაურისა და სიგრძის წაკითხვა, როცა სიმღერა დაკვრის სიაში ჩანს"

#: xmms/prefswin.c:974
msgid "load"
msgstr "გამოძახება"

#: xmms/prefswin.c:975
msgid ""
"Read song title and length as soon as the song is loaded to the playlist"
msgstr ""
"წაიკითხე სიმღერის სათაური და სიგრძე როგორც კი სიმღერა დასაკრავ სიაში "
"აღმოჩნდება"

#: xmms/prefswin.c:978
msgid "Allow multiple instances"
msgstr "ნებადართულია პროგრამის რამდენჯერმე პარალელურად გამოძახება"

