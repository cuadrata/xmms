#: General/song_change/song_change.c:313
#, c-format
msgid ""
"You can use the following format strings which will be substituted before "
"calling the command (not all are useful for the end-of-playlist command).\n"
"\n"
"%%F: Frequency (in hertz)\n"
"%%c: Number of channels\n"
"%%f: filename (full path)\n"
"%%l: length (in milliseconds)\n"
"%%n or %%s: Song name\n"
"%%r: Rate (in bits per second)\n"
"%%t: Playlist position (%%02d)\n"
"%%p: Currently playing (1 or 0)"
msgstr ""
"Mund të përdoren vargjet e mëposhtme të formatit, që zëvendësohen para "
"thirrjes së komandës (jo të gjitha janë të dobishme për komandën e fundit të "
"listës).\n"
"\n"
"%%F: frekuenca (në herc)\n"
"%%c: numri i kanaleve\n"
"%%f: emri i skedarit (shtegu i plotë)\n"
"%%l: gjatësia (në milisekonda)\n"
"%%n ose %%s: emri i këngës\n"
"%%r: shpejtësia (në bit për sekondë)\n"
"%%t: pozicioni në listë (%%02d)\n"
"%%p: luhet tani (1 ose 0)"

