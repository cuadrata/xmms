#: General/song_change/song_change.c:313
#, c-format
msgid ""
"You can use the following format strings which will be substituted before "
"calling the command (not all are useful for the end-of-playlist command).\n"
"\n"
"%%F: Frequency (in hertz)\n"
"%%c: Number of channels\n"
"%%f: filename (full path)\n"
"%%l: length (in milliseconds)\n"
"%%n or %%s: Song name\n"
"%%r: Rate (in bits per second)\n"
"%%t: Playlist position (%%02d)\n"
"%%p: Currently playing (1 or 0)"
msgstr ""
"Anda dapat memakai string format berikut, yang akan diganti sebelum perintah "
"dipanggil (tidak semuanya berguna untuk perintah akhir daftar main).\n"
"\n"
"%%F: Frekuensi (dalam hertz)\n"
"%%c: Jumlah kanal\n"
"%%f: nama file (path lengkap)\n"
"%%l: panjang (dalam milidetik)\n"
"%%n atau %%s: Nama lagu\n"
"%%r: Laju bit (bit per detik)\n"
"%%t: Posisi dalam daftar main (%%02d)\n"
"%%p: Sedang diputar (1 atau 0)"

