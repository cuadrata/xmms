#: General/song_change/song_change.c:313
#, c-format
msgid ""
"You can use the following format strings which will be substituted before "
"calling the command (not all are useful for the end-of-playlist command).\n"
"\n"
"%%F: Frequency (in hertz)\n"
"%%c: Number of channels\n"
"%%f: filename (full path)\n"
"%%l: length (in milliseconds)\n"
"%%n or %%s: Song name\n"
"%%r: Rate (in bits per second)\n"
"%%t: Playlist position (%%02d)\n"
"%%p: Currently playing (1 or 0)"
msgstr ""
"Pirms komandas izsaukšanas tiek aizstātas šādas formāta virknes (ne visas ir "
"noderīgas pleilistes beigu komandai).\n"
"\n"
"%%F: frekvence (hercos)\n"
"%%c: kanālu skaits\n"
"%%f: faila nosaukums (pilns ceļš)\n"
"%%l: garums (milisekundēs)\n"
"%%n vai %%s: dziesmas nosaukums\n"
"%%r: bitu plūsma (bitos sekundē)\n"
"%%t: pozīcija pleilistē (%%02d)\n"
"%%p: šobrīd atskaņo (1 vai 0)"

