#: General/song_change/song_change.c:313
#, c-format
msgid ""
"You can use the following format strings which will be substituted before "
"calling the command (not all are useful for the end-of-playlist command).\n"
"\n"
"%%F: Frequency (in hertz)\n"
"%%c: Number of channels\n"
"%%f: filename (full path)\n"
"%%l: length (in milliseconds)\n"
"%%n or %%s: Song name\n"
"%%r: Rate (in bits per second)\n"
"%%t: Playlist position (%%02d)\n"
"%%p: Currently playing (1 or 0)"
msgstr ""
"Można użyć następujących sekwencji formatujących, podstawianych przed "
"wywołaniem polecenia (nie wszystkie przydają się w poleceniu końca listy "
"odtwarzania).\n"
"\n"
"%%F: częstotliwość (w hercach)\n"
"%%c: liczba kanałów\n"
"%%f: nazwa pliku (pełna ścieżka)\n"
"%%l: długość (w milisekundach)\n"
"%%n lub %%s: nazwa utworu\n"
"%%r: przepływność (w bitach na sekundę)\n"
"%%t: pozycja na liście odtwarzania (%%02d)\n"
"%%p: właśnie odtwarzany (1 lub 0)"

